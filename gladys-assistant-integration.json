{
  "manifest_version": 1,
  "type": "tts",
  "name": "Microsoft Edge TTS",
  "description": {
    "en": "The free neural voices of Microsoft Edge for Gladys: 300 voices, no account, no API key.",
    "fr": "Les voix neuronales gratuites de Microsoft Edge pour Gladys : 300 voix, sans compte ni clé.",
    "de": "Die kostenlosen neuronalen Stimmen von Microsoft Edge für Gladys: 300 Stimmen, ohne Konto.",
    "es": "Las voces neuronales gratuitas de Microsoft Edge para Gladys: 300 voces, sin cuenta ni clave."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-edge-tts:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-edge-tts/main/cover.png",
  "categories": ["assistants"],
  "keywords": [
    "edge tts",
    "microsoft edge",
    "read aloud",
    "lecture à voix haute",
    "neural voices",
    "voix neuronales",
    "tts",
    "text-to-speech",
    "synthèse vocale"
  ],
  "transports": ["cloud"],
