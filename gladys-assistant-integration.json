    {
      "key": "gender",
      "type": "select",
      "label": {
        "en": "Automatic voice",
        "fr": "Voix automatique",
        "de": "Automatische Stimme",
        "es": "Voz automática"
      },
      "description": {
        "en": "In automatic mode, a female or a male voice.",
        "fr": "En mode automatique, une voix féminine ou masculine.",
        "de": "Im automatischen Modus eine weibliche oder männliche Stimme.",
        "es": "En modo automático, una voz femenina o masculina."
      },
      "required": false,
      "default": "female",
      "options": [
        {
          "value": "female",
          "label": {
            "en": "Female",
            "fr": "Féminine",
            "de": "Weiblich",
            "es": "Femenina"
          }
        },
        {
          "value": "male",
          "label": {
            "en": "Male",
            "fr": "Masculine",
            "de": "Männlich",
            "es": "Masculina"
          }
        }
      ]
    },
    {
      "key": "custom_voice",
      "type": "string",
      "label": {
        "en": "Other voice",
        "fr": "Autre voix",
        "de": "Andere Stimme",
        "es": "Otra voz"
      },
      "description": {
        "en": "Any other Edge voice, by its name (the \"List the voices\" button below gives them). Replaces the choice above.",
        "fr": "Toute autre voix Edge, par son nom (le bouton « Lister les voix » ci-dessous les donne). Remplace le choix ci-dessus.",
        "de": "Jede andere Edge-Stimme, über ihren Namen (die Taste „Stimmen auflisten“ unten nennt sie). Ersetzt die Auswahl oben.",
        "es": "Cualquier otra voz de Edge, por su nombre (el botón «Listar las voces» de abajo las da). Sustituye la elección de arriba."
      },
      "placeholder": {
        "en": "it-IT-ElsaNeural",
        "fr": "it-IT-ElsaNeural",
        "de": "it-IT-ElsaNeural",
        "es": "it-IT-ElsaNeural"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "rate",
      "type": "number",
      "label": {
        "en": "Speed (%)",
        "fr": "Débit (%)",
        "de": "Tempo (%)",
        "es": "Velocidad (%)"
      },
      "description": {
        "en": "From -50 (slower) to +100 (faster); 0 is the usual speed of the voice.",
        "fr": "De -50 (plus lent) à +100 (plus rapide) ; 0 est le débit habituel de la voix.",
        "de": "Von -50 (langsamer) bis +100 (schneller); 0 ist das übliche Tempo der Stimme.",
        "es": "De -50 (más lento) a +100 (más rápido); 0 es la velocidad habitual de la voz."
      },
      "required": false,
      "default": 0,
      "min": -50,
      "max": 100
    },
    {
      "key": "pitch",
      "type": "number",
      "label": {
        "en": "Pitch (Hz)",
        "fr": "Hauteur (Hz)",
        "de": "Tonhöhe (Hz)",
        "es": "Tono (Hz)"
      },
      "description": {
        "en": "From -50 (lower) to +50 (higher); 0 is the usual pitch of the voice.",
        "fr": "De -50 (plus grave) à +50 (plus aigu) ; 0 est la hauteur habituelle de la voix.",
        "de": "Von -50 (tiefer) bis +50 (höher); 0 ist die übliche Tonhöhe der Stimme.",
        "es": "De -50 (más grave) a +50 (más agudo); 0 es el tono habitual de la voz."
      },
      "required": false,
      "default": 0,
      "min": -50,
      "max": 50
    },
    {
      "key": "volume",
      "type": "number",
      "label": {
        "en": "Volume (%)",
        "fr": "Volume (%)",
        "de": "Lautstärke (%)",
        "es": "Volumen (%)"
      },
      "description": {
        "en": "From -50 (quieter) to +50 (louder), relative to the clip; the speaker volume stays its own.",
        "fr": "De -50 (plus bas) à +50 (plus fort), dans le clip ; le volume de l'enceinte reste le sien.",
        "de": "Von -50 (leiser) bis +50 (lauter), im Clip; die Lautstärke des Lautsprechers bleibt ihre eigene.",
        "es": "De -50 (más bajo) a +50 (más alto), en el clip; el volumen del altavoz sigue siendo el suyo."
      },
      "required": false,
      "default": 0,
      "min": -50,
      "max": 50
    }
  ],
  "actions": [
    {
      "key": "test_voice",
      "label": {
        "en": "Test the voice",
        "fr": "Tester la voix",
        "de": "Stimme testen",
        "es": "Probar la voz"
      },
      "description": {
        "en": "Asks Microsoft Edge for a test sentence with the saved settings and shows the result (save first).",
        "fr": "Demande une phrase de test à Microsoft Edge avec les réglages enregistrés et affiche le résultat (enregistrez d'abord).",
        "de": "Fragt bei Microsoft Edge einen Testsatz mit den gespeicherten Einstellungen an und zeigt das Ergebnis (zuerst speichern).",
        "es": "Pide a Microsoft Edge una frase de prueba con los ajustes guardados y muestra el resultado (guarde primero)."
      },
      "timeout_seconds": 40
    },
    {
      "key": "list_voices",
      "label": {
        "en": "List the voices",
        "fr": "Lister les voix",
        "de": "Stimmen auflisten",
        "es": "Listar las voces"
      },
      "description": {
        "en": "Gives the names of the Edge voices of a language, to copy into \"Other voice\".",
        "fr": "Donne le nom des voix Edge d'une langue, à copier dans « Autre voix ».",
        "de": "Nennt die Namen der Edge-Stimmen einer Sprache, zum Kopieren in „Andere Stimme“.",
        "es": "Da los nombres de las voces de Edge de un idioma, para copiarlos en «Otra voz»."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "language",
          "type": "string",
          "label": {
            "en": "Language code",
            "fr": "Code de langue",
            "de": "Sprachcode",
            "es": "Código de idioma"
          },
          "placeholder": {
            "en": "it, pt-BR",
            "fr": "it, pt-BR",
            "de": "it, pt-BR",
            "es": "it, pt-BR"
          },
          "required": true
        }
      ]
    }
  ]
}
